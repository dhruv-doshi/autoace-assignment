# Required: your OpenRouter API key (keep the real value in .env).
OPENROUTER_API_KEY=your-openrouter-key

# Required: password for opening the dashboard.
AUTOACE_DASHBOARD_PASSWORD=choose-a-strong-password

# Optional settings.
AUTOACE_OPENROUTER_BUDGET_USD=0.10
AUTOACE_MAX_FILES_PER_RUN=25
# AUTOACE_WHISPER_MODEL_PATH=models/faster-whisper/tiny
# OPENROUTER_SITE_URL=http://localhost
# OPENROUTER_APP_NAME=AutoAce
